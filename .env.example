# Este arquivo é só um MODELO. As chaves de verdade ficam no jarvis/.env do SEU computador (nunca no GitHub nem na Vercel).
# No PC: copie para jarvis/.env e preencha.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
PORT=3000

# Contas de cada pessoa (Supabase > Project Settings > API Keys). Use a chave PÚBLICA:
# "Publishable key" (sb_publishable_...) ou a antiga "anon". NUNCA a "secret"/"service_role" (o site recusa).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE-AQUI-A-CHAVE-PUBLICA

# (Opcional) Chave PAGA do Gemini, só para o nível 5.1 (Gemini 4 Argon). Fica no jarvis/.env do seu PC, nunca na Vercel.
GEMINI_API_KEY_PAGO=
